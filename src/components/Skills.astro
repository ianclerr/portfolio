---
import { needsLightInk, skillGroups, skillIntro } from "../data/skills";
---

<section id="skills">
  <h2 class="section-title">Technical Skills</h2>
  <p class="skills-lead">{skillIntro}</p>
  <div class="skill-groups">
    {
      skillGroups.map((group) => (
        <div class="skill-group">
          <h3>{group.title}</h3>
          <div class="skill-row">
            {group.items.map((item) => (
              <div class:list={["skill-logo", needsLightInk(item.icon.hex) && "is-ink"]} style={`--brand: #${item.icon.hex}`}>
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <path d={item.icon.path} />
                </svg>
                <span>{item.label}</span>
              </div>
            ))}
          </div>
        </div>
      ))
    }
  </div>
</section>
