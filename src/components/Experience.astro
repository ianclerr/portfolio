---
import { useI18n } from "../i18n";

const { t, roles } = useI18n(Astro.currentLocale);
---

<section id="experience">
  <h2 class="section-title">{t.experienceTitle}</h2>
  <div class="roles">
    {
      roles.map((role) => (
        <article class="role">
          <p class="role-when">
            <span>{role.start}</span>
            <span>{role.end}</span>
          </p>
          <div class="role-body">
            <h3 class="role-title">{role.title}</h3>
            <p class="role-company">{role.company}</p>
            <p class="role-place">{role.place}</p>
            <ul class="role-points">
              {role.highlights.map((point) => (
                <li set:html={point} />
              ))}
            </ul>
            <div class="timeline-tech">
              {role.tech.map((tag) => (
                <span class="tech-tag">{tag}</span>
              ))}
            </div>
          </div>
        </article>
      ))
    }
  </div>
</section>
