---
import { site } from "../data/site";
import { terminalScript, useI18n } from "../i18n";

const { locale, t } = useI18n(Astro.currentLocale);
---

<section id="home" class="hero">
  <div class="hero-content">
    <p class="intro">{t.heroIntro}</p>
    <h1>{site.name}</h1>
    <p class="subtitle">{t.role}</p>
    <p class="description">{t.heroDescription}</p>
    <div class="cta-buttons">
      <a href={locale === "es" ? "/es/#contact" : "/#contact"} class="cta-button">
        <i class="fas fa-rocket"></i>
        {t.letsWork}
      </a>
      <a href={locale === "es" ? "/es/#projects" : "/#projects"} class="cta-button cta-secondary">
        <i class="fas fa-code"></i>
        {t.viewProjects}
      </a>
    </div>
  </div>
  <div class="terminal-container">
    <div class="terminal-header">
      <div class="terminal-dot dot-red"></div>
      <div class="terminal-dot dot-yellow"></div>
      <div class="terminal-dot dot-green"></div>
      <div class="terminal-title">ian@portfolio:~$</div>
    </div>
    <div class="terminal-body" id="terminal" data-lines={JSON.stringify(terminalScript(locale))}></div>
  </div>
</section>
