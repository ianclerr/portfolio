---
import { navLinks } from "../data/site";
---

<div class="mobile-nav-overlay" id="mobileNavOverlay">
  <ul class="nav-links">
    {
      navLinks.map((link) => (
        <li>
          <a href={link.href} class="mobile-nav-link">
            {link.mobileLabel}
          </a>
        </li>
      ))
    }
  </ul>
</div>
