---
import BaseLayout from "../layouts/BaseLayout.astro";
import { site } from "../data/site";
import LanguageSelect from "./LanguageSelect.astro";
import { localizePath, useI18n } from "../i18n";
import "../styles/coarco.css";

const { locale, coarco } = useI18n(Astro.currentLocale, Astro.url.pathname);
const home = localizePath(locale, "/");
const contact = localizePath(locale, "/#contact");

const tagTone: Record<string, string> = {
  "tag-pink": "neon-text-pink",
  "tag-cyan": "neon-text-cyan",
  "tag-green": "neon-text-green",
};
---

<BaseLayout
  title={coarco.pageTitle}
  description={coarco.pageDescription}
  lang={locale}
  bodyClass="bg-gradient-anim min-h-screen font-inter text-white"
>
  <header class="fixed top-0 z-50 w-full border-b border-cyan-400/40 bg-[rgba(10,10,10,0.95)] backdrop-blur-[20px]">
    <div class="mx-auto flex max-w-6xl items-center justify-between px-6 py-4">
      <a href={home} class="flex items-center gap-3 font-semibold text-cyan-400 transition-colors hover:text-cyan-300">
        <i class="fas fa-arrow-left"></i>
        <span class="font-fira">{coarco.back}</span>
      </a>
      <div class="flex items-center gap-5">
        <LanguageSelect />
        <span class="font-fira text-lg font-bold text-cyan-400 [text-shadow:0_0_10px_#00ffff]">{site.logo}</span>
      </div>
    </div>
  </header>

  <main class="mx-auto max-w-5xl px-6 pb-20 pt-28">
    <div class="mb-16 text-center">
      <div class="tag-green mb-6 inline-flex items-center gap-2 rounded-full px-4 py-2 font-fira text-sm">
        <i class="fas fa-circle animate-pulse text-xs"></i>
        {coarco.eyebrow}
      </div>
      <h1 class="neon-text-cyan mb-4 font-inter text-5xl font-bold md:text-6xl">{coarco.title}</h1>
      <p class="mb-6 font-fira text-xl text-gray-400">{coarco.subtitle}</p>
      <div class="gradient-line mx-auto mb-8 w-32 rounded-full"></div>
      <p class="mx-auto max-w-2xl text-lg leading-relaxed text-gray-300">{coarco.summary}</p>
    </div>

    <div class="mb-16 grid grid-cols-1 gap-6 md:grid-cols-3">
      {
        coarco.facts.map((fact) => (
          <div class:list={[fact.card, "rounded-2xl p-6 text-center"]}>
            <i class:list={[fact.icon, fact.tone, "mb-3 block text-3xl"]} />
            <p class="mb-1 font-fira text-sm text-gray-400">{fact.label}</p>
            <p class="font-semibold text-white">{fact.value}</p>
          </div>
        ))
      }
    </div>

    <section class="card-border-cyan mb-10 rounded-2xl p-8">
      <h2 class="neon-text-cyan mb-4 flex items-center gap-3 text-2xl font-bold">
        <i class="fas fa-info-circle"></i>
        {coarco.whatIs}
      </h2>
      <div class="gradient-line mb-6 w-full rounded-full"></div>
      {
        coarco.about.map((paragraph) => (
          <p class="mb-4 leading-relaxed text-gray-300 last:mb-0" set:html={paragraph} />
        ))
      }
    </section>

    <section class="mb-10">
      <h2 class="neon-text-pink mb-2 flex items-center gap-3 text-2xl font-bold">
        <i class="fas fa-cubes"></i>
        {coarco.modulesTitle}
      </h2>
      <div class="gradient-line mb-8 w-full rounded-full"></div>
      <div class="grid grid-cols-1 gap-6 md:grid-cols-2">
        {
          coarco.modules.map((module) => (
            <div class:list={[module.card, "module-card rounded-2xl p-6"]}>
              <div class="mb-4 flex items-center gap-3">
                <i class:list={[module.icon, module.tone, "text-2xl"]} />
                <h3 class="text-lg font-semibold text-white">{module.title}</h3>
              </div>
              <p class="text-sm leading-relaxed text-gray-400">{module.text}</p>
            </div>
          ))
        }
      </div>
    </section>

    <section class="card-border-cyan mb-10 rounded-2xl p-8">
      <h2 class="neon-text-cyan mb-2 flex items-center gap-3 text-2xl font-bold">
        <i class="fas fa-layer-group"></i>
        {coarco.stackTitle}
      </h2>
      <div class="gradient-line mb-8 w-full rounded-full"></div>
      <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
        {
          coarco.stack.map((group) => (
            <div>
              <h3 class:list={["mb-3 font-fira text-sm uppercase tracking-widest", tagTone[group.tag]]}>
                {group.title}
              </h3>
              <div class="flex flex-wrap gap-2">
                {group.items.map((item) => (
                  <span class:list={[group.tag, "rounded-full px-3 py-1 font-fira text-xs"]}>
                    <i class:list={[item.icon, "mr-1"]} />
                    {item.label}
                  </span>
                ))}
              </div>
            </div>
          ))
        }
      </div>
    </section>

    <section class="card-border-green mb-16 rounded-2xl p-8">
      <h2 class="neon-text-green mb-2 flex items-center gap-3 text-2xl font-bold">
        <i class="fas fa-user-check"></i>
        {coarco.contributionsTitle}
      </h2>
      <div class="gradient-line mb-6 w-full rounded-full"></div>
      <ul class="space-y-4">
        {
          coarco.contributions.map((item) => (
            <li class="flex items-start gap-4">
              <i class="fas fa-check-circle neon-text-green mt-1 shrink-0" />
              <p class="text-gray-300" set:html={item} />
            </li>
          ))
        }
      </ul>
    </section>

    <div class="text-center">
      <p class="mb-6 text-gray-400">{coarco.interested}</p>
      <div class="flex flex-wrap justify-center gap-4">
        <a
          href={contact}
          class="inline-flex items-center gap-2 rounded-full bg-[linear-gradient(45deg,#00ffff,#ff00ff)] px-8 py-3 font-semibold text-black shadow-[0_0_20px_rgba(0,255,255,0.3)] transition-all hover:-translate-y-1"
        >
          <i class="fas fa-rocket"></i>
          {coarco.letsWork}
        </a>
        <a
          href={coarco.whatsapp}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 rounded-full bg-[linear-gradient(45deg,#25D366,#128C7E)] px-8 py-3 font-semibold text-white shadow-[0_0_20px_rgba(37,211,102,0.3)] transition-all hover:-translate-y-1"
        >
          <i class="fab fa-whatsapp"></i>
          WhatsApp
        </a>
      </div>
    </div>
  </main>

  <footer class="mt-10 border-t border-cyan-400/20 py-6 text-center font-fira text-sm text-gray-500">
    <p>&copy; 2026 {site.name} · <span class="neon-text-cyan">{coarco.roleLine}</span></p>
  </footer>
</BaseLayout>
