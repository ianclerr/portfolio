---
import { useI18n } from "../i18n";

const { t, projects } = useI18n(Astro.currentLocale);
---

<section id="projects">
  <h2 class="section-title">{t.projectsTitle}</h2>
  <div class="projects-grid">
    {
      projects.map((project) => (
        <div class="project-card">
          <div class:list={["project-image", project.preview && "has-preview"]}>
            {project.preview ? (
              <a
                class="project-preview"
                href={project.links[0].href}
                target={project.links[0].newTab ? "_blank" : undefined}
                rel={project.links[0].newTab ? "noopener noreferrer" : undefined}
              >
                <img src={project.preview} alt={`${project.title} ${t.previewAlt}`} />
              </a>
            ) : (
              <i class:list={[project.icon, "project-icon"]} />
            )}
          </div>
          <div class="project-content">
            <div class="project-header">
              <h3>{project.title}</h3>
              <span class="project-status">{project.status}</span>
            </div>
            <p class="project-description">{project.description}</p>
            <div class="project-tech">
              {project.tech.map((tag) => (
                <span class="tech-tag">{tag}</span>
              ))}
            </div>
            <div class="project-links">
              {project.links.map((link) => (
                <a
                  href={link.href}
                  class="project-link"
                  target={link.newTab ? "_blank" : undefined}
                  rel={link.newTab ? "noopener noreferrer" : undefined}
                >
                  <i class={link.icon} />
                  {link.label}
                </a>
              ))}
            </div>
          </div>
        </div>
      ))
    }
  </div>
</section>
