---
import { contactLinks } from "../data/contact";
import { site } from "../data/site";
---

<footer class="footer footer-slim">
  <div class="footer-slim-row">
    <p class="footer-brand">{site.logo}</p>
    <div class="footer-social">
      <a href={site.linkedin} target="_blank" rel="noopener noreferrer" class="footer-social-link" aria-label="LinkedIn">
        <i class="fab fa-linkedin-in"></i>
      </a>
      <a href={site.github} target="_blank" rel="noopener noreferrer" class="footer-social-link" aria-label="GitHub">
        <i class="fab fa-github"></i>
      </a>
      <a href={contactLinks.email} class="footer-social-link" aria-label="Email">
        <i class="fas fa-envelope"></i>
      </a>
      <a href={contactLinks.whatsappPlain} target="_blank" rel="noopener noreferrer" class="footer-social-link" aria-label="WhatsApp">
        <i class="fab fa-whatsapp"></i>
      </a>
    </div>
  </div>
  <p class="footer-copy">&copy; 2026 {site.name}</p>
</footer>
