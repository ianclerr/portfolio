---
import { contactLinks, footerTech } from "../data/contact";
import { navLinks, site } from "../data/site";
---

<footer class="footer">
  <div class="footer-content">
    <div class="footer-section">
      <div class="footer-logo">
        <h3>{site.logo}</h3>
        <p>Full Stack Developer specialized in end-to-end development</p>
      </div>
      <div class="footer-social">
        <a href={site.linkedin} target="_blank" rel="noopener noreferrer" class="footer-social-link" aria-label="LinkedIn">
          <i class="fab fa-linkedin-in"></i>
        </a>
        <a href={site.github} target="_blank" rel="noopener noreferrer" class="footer-social-link" aria-label="GitHub">
          <i class="fab fa-github"></i>
        </a>
        <a href={contactLinks.email} class="footer-social-link" aria-label="Email">
          <i class="fas fa-envelope"></i>
        </a>
        <a href={contactLinks.whatsappPlain} target="_blank" rel="noopener noreferrer" class="footer-social-link" aria-label="WhatsApp">
          <i class="fab fa-whatsapp"></i>
        </a>
      </div>
    </div>

    <div class="footer-section">
      <h4>Navigation</h4>
      <ul class="footer-links">
        {
          navLinks.map((link) => (
            <li>
              <a href={link.href}>{link.label}</a>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="footer-section">
      <h4>Technologies</h4>
      <ul class="footer-links">
        {footerTech.map((item) => <li>{item}</li>)}
      </ul>
    </div>

    <div class="footer-section">
      <h4>Quick Contact</h4>
      <div class="footer-contact">
        <p><i class="fas fa-envelope"></i> {site.email}</p>
        <p><i class="fas fa-map-marker-alt"></i> {site.location}</p>
        <p><i class="fas fa-clock"></i> Available for projects</p>
      </div>
      <a href={contactLinks.whatsappFooter} target="_blank" rel="noopener noreferrer" class="footer-cta">
        <i class="fab fa-whatsapp"></i>
        WhatsApp
      </a>
    </div>
  </div>

  <div class="footer-bottom">
    <div class="footer-bottom-content">
      <p>&copy; 2026 {site.name}. All rights reserved.</p>
      <p>Developed with ❤️ and lots of ☕</p>
    </div>
  </div>
</footer>
