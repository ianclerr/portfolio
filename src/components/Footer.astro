---
import { footerTech } from "../data/contact";
import { site } from "../data/site";
import { useI18n } from "../i18n";

const { t, nav, links } = useI18n(Astro.currentLocale);
---

<footer class="footer">
  <div class="footer-content">
    <div class="footer-section">
      <div class="footer-logo">
        <h3>{site.logo}</h3>
        <p>{t.footerBlurb}</p>
      </div>
      <div class="footer-social">
        <a href={site.linkedin} target="_blank" rel="noopener noreferrer" class="footer-social-link" aria-label="LinkedIn">
          <i class="fab fa-linkedin-in"></i>
        </a>
        <a href={site.github} target="_blank" rel="noopener noreferrer" class="footer-social-link" aria-label="GitHub">
          <i class="fab fa-github"></i>
        </a>
        <a href={links.email} class="footer-social-link" aria-label="Email">
          <i class="fas fa-envelope"></i>
        </a>
        <a href={links.whatsappPlain} target="_blank" rel="noopener noreferrer" class="footer-social-link" aria-label="WhatsApp">
          <i class="fab fa-whatsapp"></i>
        </a>
      </div>
    </div>

    <div class="footer-section">
      <h4>{t.navigation}</h4>
      <ul class="footer-links">
        {
          nav.map((link) => (
            <li>
              <a href={link.href}>{link.label}</a>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="footer-section">
      <h4>{t.technologies}</h4>
      <ul class="footer-links">
        {footerTech.map((item) => <li>{item}</li>)}
      </ul>
    </div>

    <div class="footer-section">
      <h4>{t.quickContact}</h4>
      <div class="footer-contact">
        <p><i class="fas fa-envelope"></i> {site.email}</p>
        <p><i class="fas fa-map-marker-alt"></i> {site.location}</p>
        <p><i class="fas fa-clock"></i> {t.available}</p>
      </div>
      <a href={links.whatsappFooter} target="_blank" rel="noopener noreferrer" class="footer-cta">
        <i class="fab fa-whatsapp"></i>
        WhatsApp
      </a>
    </div>
  </div>

  <div class="footer-bottom">
    <div class="footer-bottom-content">
      <p>&copy; 2026 {site.name}. {t.rights}</p>
    </div>
  </div>
</footer>
