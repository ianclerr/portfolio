---
import { site } from "../data/site";
import { useI18n } from "../i18n";

const { t, links } = useI18n(Astro.currentLocale);
---

<section id="contact">
  <h2 class="section-title">{t.contactTitle}</h2>
  <div class="contact-stage">
    <div class="contact-stage-main">
      <p class="contact-kicker">{t.contactKicker}</p>
      <h3>{t.contactHeading}</h3>
      <p>
        {t.contactBody} {site.location}.
      </p>
      <a href={links.whatsapp} target="_blank" rel="noopener noreferrer" class="whatsapp-btn">
        <i class="fab fa-whatsapp"></i>
        {t.whatsappCta}
      </a>
    </div>
    <div class="contact-stage-side">
      <h4>{t.offersTitle}</h4>
      <ul class="offer-list">
        {
          t.offers.map((offer) => (
            <li>
              <i class="fas fa-check" />
              {offer}
            </li>
          ))
        }
      </ul>
      <div class="contact-lines">
        <a href={links.email}>
          <i class="fas fa-envelope"></i>
          {site.email}
        </a>
        <a href={site.linkedin} target="_blank" rel="noopener noreferrer">
          <i class="fab fa-linkedin-in"></i>
          LinkedIn
        </a>
        <a href={site.github} target="_blank" rel="noopener noreferrer">
          <i class="fab fa-github"></i>
          GitHub
        </a>
        <span>
          <i class="fas fa-map-marker-alt"></i>
          {site.location} · {t.remote}
        </span>
      </div>
    </div>
  </div>
</section>
