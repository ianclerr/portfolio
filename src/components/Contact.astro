---
import { contactLinks } from "../data/contact";
import { site } from "../data/site";
---

<section id="contact" class="close">
  <h2 class="section-title">Let's Work Together</h2>
  <p class="skills-lead">WhatsApp or email. I usually reply the same day.</p>
  <div class="close-actions">
    <a href={contactLinks.whatsapp} target="_blank" rel="noopener noreferrer" class="whatsapp-btn">
      <i class="fab fa-whatsapp"></i>
      WhatsApp
    </a>
    <a href={contactLinks.email} class="cta-button cta-secondary">
      <i class="fas fa-envelope"></i>
      Email
    </a>
  </div>
  <div class="close-links">
    <a href={contactLinks.email}>{site.email}</a>
    <a href={site.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn</a>
    <a href={site.github} target="_blank" rel="noopener noreferrer">GitHub</a>
    <span>{site.location} · Remote or hybrid</span>
  </div>
</section>
