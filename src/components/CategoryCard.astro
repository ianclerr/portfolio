---
import type { SkillTag } from "../data/skills";

interface Props {
  icon: string;
  title: string;
  description: string;
  tags?: SkillTag[];
}

const { icon, title, description, tags = [] } = Astro.props;
---

<div class="category-card">
  <i class:list={[icon, "category-icon"]}></i>
  <h3>{title}</h3>
  <p>{description}</p>
  {
    tags.length > 0 && (
      <div class="skill-tags">
        {tags.map((tag) => (
          <span class="skill-tag">
            <i class={tag.icon} />
            {tag.label}
          </span>
        ))}
      </div>
    )
  }
</div>
