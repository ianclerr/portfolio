---
import LanguageSelect from "./LanguageSelect.astro";
import { site } from "../data/site";
import { useI18n } from "../i18n";

const { t, nav } = useI18n(Astro.currentLocale, Astro.url.pathname);
---

<header>
  <nav>
    <div class="nav-left">
      <div class="logo">{site.logo}</div>
      <ul class="nav-links">
        {
          nav.map((link) => (
            <li>
              <a href={link.href}>{link.label}</a>
            </li>
          ))
        }
      </ul>
    </div>
    <div class="nav-right">
      <LanguageSelect />
      <button class="theme-toggle" id="themeToggle" title={t.themeLabel} type="button">
        <i class="fas fa-moon" id="themeIcon"></i>
      </button>
      <div class="mobile-menu" id="mobileMenuBtn">
        <i class="fas fa-bars"></i>
      </div>
    </div>
  </nav>
</header>
